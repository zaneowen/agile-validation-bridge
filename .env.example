# Copy to .env (never commit .env). Leave the key empty to run with the mock AI.
ANTHROPIC_API_KEY=
# Optional overrides
AVB_MODEL=claude-sonnet-5-5
AVB_DB=avb.db
# Require a login (recommended for any hosted copy). Comma-separated user:password pairs.
# The logged-in name is what the audit trail records.
AVB_USERS=
